{
  "name": "stem-mantra-monorepo",
  "version": "1.0.0",
  "description": "STEMmantra - Next.js website (backend to be rebuilt)",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "cd frontend && npm run start",
    "lint": "cd frontend && npm run lint",
    "type-check": "cd frontend && npm run type-check",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "clean": "rimraf frontend/node_modules frontend/.next node_modules"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "STEMmantra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arya4546/Stem_mantra.git"
  },
  "keywords": [
    "stem",
    "education",
    "robotics",
    "nextjs",
    "typescript",
    "monorepo"
  ],
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdf-poppler": "^0.2.3",
    "sharp": "^0.34.5"
  }
}
