# Build context for the root Dockerfile: only source code goes in.

# Secrets — never in an image
**/.env
**/.env.*
!**/.env.example
**/*.php
**/*.pem

# Dependencies and build output (rebuilt inside the image)
**/node_modules
**/.next
**/dist
**/out
**/*.tsbuildinfo
**/*.log
**/logs

# Not needed to build or run the site
.git
.github
.vscode
deploy
*.md
**/.DS_Store
frontend/Exhibition Snap
frontend/session in action
frontend/src/_deferred_routes
