# ──────────────────────────────────────────────
# STEMmantra website server — environment
# Copy to .env (local) or put in /opt/stemmantra-site/.env on the VPS.
# ──────────────────────────────────────────────

# NODE_ENV and PORT are set by docker-compose.yml in production.
NODE_ENV=development
PORT=3000
# Public URL of the site (allowed origin for admin requests; links in emails). Production: https://www.stemmantra.com
SITE_URL=http://localhost:3000
# Number of reverse proxies in front of the app (nginx = 1). Used for client IPs / rate limiting.
TRUST_PROXY=1
LOG_LEVEL=http
# Print every SQL query + duration in the terminal (default: on in development, off in production)
# LOG_QUERIES=true

# ── Observability: OpenTelemetry → SigNoz (leave the endpoint empty to disable) ──
# Self-hosted SigNoz: http://<signoz-otel-collector-host>:4318
# SigNoz Cloud:       https://ingest.<region>.signoz.cloud:443  (+ OTEL_EXPORTER_OTLP_HEADERS below)
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<your-ingestion-key>
OTEL_SERVICE_NAME=stemmantra-website

# PostgreSQL. The database is created automatically by the first `prisma migrate` if it doesn't exist.
# On the VPS it is a separate database inside the LMS Postgres container (same user/password as the LMS):
#   DATABASE_URL=postgresql://<LMS POSTGRES_USER>:<LMS POSTGRES_PASSWORD>@stemmantra_db:5432/stemmantra_site?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stemmantra_site?schema=public

# JWT secrets (at least 32 chars, different from each other). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string_1
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7

# Super admin — created on first start if no SUPER_ADMIN exists (same as the LMS)
ADMIN_EMAIL=admin@stemmantra.com
ADMIN_PASSWORD=ChangeThisPassword!2024
ADMIN_FULL_NAME=Stem Mantra Admin

# Email (Brevo SMTP — same credentials as the LMS)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_EMAIL=noreply@stemmantra.com
MAIL_FROM_NAME=STEMmantra Website
# Comma-separated list of addresses that receive contact / demo enquiries
ENQUIRY_RECIPIENTS=sales@stemmantra.com

# Backblaze B2 (S3 compatible — same bucket/keys as the LMS)
BACKBLAZE_BUCKET_NAME=
BACKBLAZE_ENDPOINT=https://s3.us-east-005.backblazeb2.com
BACKBLAZE_REGION=us-east-005
BACKBLAZE_KEY_ID=
BACKBLAZE_APP_KEY=
# Every website object lives under this prefix (keeps it apart from LMS content).
# Production: website · local development: website-dev
B2_PREFIX=website

# Uploads
MAX_UPLOAD_MB=15

# Rate limits
RATE_LIMIT_GLOBAL_LIMIT=1500
RATE_LIMIT_AUTH_LIMIT=20
RATE_LIMIT_ENQUIRY_LIMIT=5
RATE_LIMIT_UPLOAD_LIMIT=300
