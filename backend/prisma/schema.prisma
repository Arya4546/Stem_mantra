generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum MediaStorage {
  LOCAL // shipped with the frontend (frontend/public)
  B2 // uploaded by admins to Backblaze B2
}

enum GalleryLayout {
  GRID // uniform 4:3 tiles
  MASONRY // natural aspect ratio (good for press clippings)
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum EnquiryType {
  CONTACT
  DEMO
}

enum EnquiryStatus {
  NEW
  READ
  ARCHIVED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// ============================================================
// AUTH
// ============================================================

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String    @map("password_hash")
  fullName            String    @map("full_name")
  role                Role      @default(EDITOR)
  isActive            Boolean   @default(true) @map("is_active")
  /// Bumped on password change / deactivation: invalidates every issued access token.
  tokenVersion        Int       @default(0) @map("token_version")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  passwordChangedAt   DateTime? @map("password_changed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  blogPosts     BlogPost[]
  mediaAssets   MediaAsset[]
  auditLogs     AuditLog[]

  @@map("users")
}

/// Opaque refresh tokens (only a SHA-256 hash is stored). Rotated on every use;
/// re-use of a rotated token revokes the whole family (token theft detection).
model RefreshToken {
  id          String    @id @default(uuid())
  tokenHash   String    @unique @map("token_hash")
  familyId    String    @map("family_id")
  userId      String    @map("user_id")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  replacedBy  String?   @map("replaced_by")
  userAgent   String?   @map("user_agent") @db.VarChar(300)
  ip          String?   @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String   @db.VarChar(60)
  entity    String   @db.VarChar(60)
  entityId  String?  @map("entity_id")
  summary   String?  @db.VarChar(300)
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ============================================================
// MEDIA
// ============================================================

model MediaAsset {
  id           String       @id @default(uuid())
  storage      MediaStorage
  /// B2 object key of the main file (null for LOCAL assets)
  key          String?      @unique
  thumbKey     String?      @unique @map("thumb_key")
  /// Public URL path, e.g. /media/website/gallery/2026/11/<id>.webp or /images/gallery/x.jpg
  url          String
  thumbUrl     String?      @map("thumb_url")
  mimeType     String       @map("mime_type") @db.VarChar(60)
  width        Int?
  height       Int?
  sizeBytes    Int?         @map("size_bytes")
  /// Tiny inline placeholder (data URL) used for blur-up loading
  blurDataUrl  String?      @map("blur_data_url")
  originalName String?      @map("original_name") @db.VarChar(255)
  purpose      String       @default("general") @db.VarChar(30)
  createdById  String?      @map("created_by_id")
  createdAt    DateTime     @default(now()) @map("created_at")

  createdBy     User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  galleryImages GalleryImage[]
  clientLogos   Client[]
  testimonials  Testimonial[]
  blogCovers    BlogPost[]

  @@index([createdAt])
  @@map("media_assets")
}

// ============================================================
// GALLERY
// ============================================================

model GalleryCategory {
  id          String        @id @default(uuid())
  name        String        @unique @db.VarChar(80)
  slug        String        @unique @db.VarChar(100)
  /// Small badge shown above the section title, e.g. "Hands-on Learning"
  tagline     String?       @db.VarChar(60)
  description String?       @db.VarChar(500)
  accent      String        @default("orange") @db.VarChar(20)
  layout      GalleryLayout @default(GRID)
  sortOrder   Int           @default(0) @map("sort_order")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  images GalleryImage[]

  @@index([isActive, sortOrder])
  @@map("gallery_categories")
}

model GalleryImage {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  mediaId     String   @map("media_id")
  title       String?  @db.VarChar(150)
  altText     String   @map("alt_text") @db.VarChar(250)
  caption     String?  @db.VarChar(500)
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(true) @map("is_published")
  /// Shown in the home page "Moments of Innovation" preview
  isFeatured  Boolean  @default(false) @map("is_featured")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category GalleryCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  media    MediaAsset      @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([categoryId, isPublished, sortOrder])
  @@index([isFeatured, isPublished])
  @@map("gallery_images")
}

// ============================================================
// CLIENTS & TESTIMONIALS
// ============================================================

model Client {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(150)
  logoId      String?  @map("logo_id")
  location    String?  @db.VarChar(120)
  description String?  @db.VarChar(2000)
  websiteUrl  String?  @map("website_url") @db.VarChar(300)
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(true) @map("is_published")
  /// Shown in the scrolling logo strips (home page / clients page)
  isFeatured  Boolean  @default(true) @map("is_featured")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  logo MediaAsset? @relation(fields: [logoId], references: [id], onDelete: SetNull)

  @@index([isPublished, sortOrder])
  @@map("clients")
}

model Testimonial {
  id           String   @id @default(uuid())
  authorName   String   @map("author_name") @db.VarChar(120)
  designation  String?  @db.VarChar(120)
  organization String?  @db.VarChar(200)
  photoId      String?  @map("photo_id")
  content      String   @db.VarChar(2000)
  rating       Int      @default(5)
  sortOrder    Int      @default(0) @map("sort_order")
  isPublished  Boolean  @default(true) @map("is_published")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  photo MediaAsset? @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([isPublished, sortOrder])
  @@map("testimonials")
}

// ============================================================
// BLOG
// ============================================================

model BlogPost {
  id              String     @id @default(uuid())
  title           String     @db.VarChar(200)
  slug            String     @unique @db.VarChar(220)
  excerpt         String?    @db.VarChar(400)
  /// Sanitised HTML
  content         String
  coverId         String?    @map("cover_id")
  coverAlt        String?    @map("cover_alt") @db.VarChar(250)
  metaTitle       String?    @map("meta_title") @db.VarChar(70)
  metaDescription String?    @map("meta_description") @db.VarChar(170)
  tags            String[]   @default([])
  status          PostStatus @default(DRAFT)
  publishedAt     DateTime?  @map("published_at")
  readingMinutes  Int        @default(1) @map("reading_minutes")
  authorId        String?    @map("author_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  cover  MediaAsset? @relation(fields: [coverId], references: [id], onDelete: SetNull)
  author User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@map("blog_posts")
}

// ============================================================
// ENQUIRIES (contact + book-a-demo forms)
// ============================================================

model Enquiry {
  id           String        @id @default(uuid())
  type         EnquiryType
  name         String        @db.VarChar(100)
  email        String        @db.VarChar(150)
  phone        String?       @db.VarChar(30)
  organization String?       @db.VarChar(200)
  interest     String?       @db.VarChar(100)
  message      String?       @db.VarChar(3000)
  status       EnquiryStatus @default(NEW)
  emailStatus  EmailStatus   @default(PENDING) @map("email_status")
  sourcePath   String?       @map("source_path") @db.VarChar(300)
  ip           String?       @db.VarChar(64)
  userAgent    String?       @map("user_agent") @db.VarChar(300)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("enquiries")
}

// ============================================================
// SETTINGS (one-off markers such as "initial content imported")
// ============================================================

model AppSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
